# Q5 — Trajectory of organizations an author belonged to.
# Demonstrates that the n-ary Affiliation captures temporality
# (multiple orgs along the same author's life — feedback point).
PREFIX iaos: <https://w3id.org/iaos/ontology#>

SELECT ?authorName ?orgName ?role ?startDate ?endDate
WHERE {
    ?person a iaos:Person ;
            iaos:name ?authorName ;
            iaos:hasAffiliation ?aff .
    ?aff iaos:atOrganization ?org ;
         iaos:startDate ?startDate .
    OPTIONAL { ?aff iaos:endDate ?endDate }
    OPTIONAL { ?aff iaos:role    ?role    }
    ?org iaos:name ?orgName .
}
ORDER BY ?authorName ?startDate
