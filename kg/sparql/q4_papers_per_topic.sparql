# Q4 — Papers grouped by topic, only counting assignments above the threshold.
PREFIX iaos: <https://w3id.org/iaos/ontology#>

SELECT ?topicLabel (COUNT(?paper) AS ?nPapers)
       (AVG(?prob)  AS ?avgProb)
WHERE {
    ?paper a iaos:Paper ;
           iaos:hasTopicAssignment ?ta .
    ?ta iaos:aboutTopic ?topic ;
        iaos:probability ?prob ;
        iaos:topicThreshold ?thr .
    ?topic iaos:label ?topicLabel .
    FILTER (?prob >= ?thr)
}
GROUP BY ?topicLabel
ORDER BY DESC(?nPapers)
