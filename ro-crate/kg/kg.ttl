<https://w3id.org/iaos/resource/paper/https-doi-org-10-1093-bioinformatics-btp-df9b12007b> a iaos:Paper ;
    iaos:abstract "SUMMARY: The Sequence Alignment/Map (SAM) format is a generic alignment format for storing read alignments against reference sequences, supporting short and long reads (up to 128 Mbp) produced by different sequencing platforms. It is flexible in style, compact in size, efficient in random access and is the format in which alignments from the 1000 Genomes Project are released. SAMtools implements various utilities for post-processing alignments in the SAM format, such as indexing, variant caller and alignment viewer, and thus provides universal tools for processing read alignments. AVAILABILITY: http://samtools.sourceforge.net." ;
    iaos:doi "https://doi.org/10.1093/bioinformatics/btp352"^^xsd:anyURI ;
    iaos:hasTopicAssignment <https://w3id.org/iaos/resource/topicassignment/https-doi-org-10-1093-bioinformatics-btp-eb230bbc54> ;
    iaos:title "The Sequence Alignment/Map format and SAMtools" ;
    iaos:venue "Bioinformatics" ;
    iaos:year "2009"^^xsd:gYear .

